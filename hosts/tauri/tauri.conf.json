{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-shells-tauri",
  "version": "0.1.0",
  "identifier": "com.warefeats.desktop-shells",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "desktop-shells", "width": 1280, "height": 720, "resizable": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
